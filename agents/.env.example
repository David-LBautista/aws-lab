# Copia este archivo como server/.env
# Sin ANTHROPIC_API_KEY el laboratorio usa el agente mock (gratis).

# API key de Claude Console (platform.claude.com). Se paga aparte de Claude Pro.
ANTHROPIC_API_KEY=

# Modelo de Claude a usar en modo real
CLAUDE_MODEL=claude-sonnet-5-5

# mock | claude  (si no lo pones: claude cuando hay API key, mock si no)
# AGENT_MODE=mock

# Velocidad del agente mock en milisegundos entre "tokens"
MOCK_DELAY_MS=35

PORT=8787
